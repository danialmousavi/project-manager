# Internal network: http://SERVER_IP (set SESSION_COOKIE_SECURE=false).
# Public domain: https://project.example.com (set SESSION_COOKIE_SECURE=true).
APP_URL=http://192.168.1.100
SESSION_COOKIE_SECURE=false
POSTGRES_USER=project_user
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_ALPHANUMERIC_PASSWORD
POSTGRES_DB=project_manager
# Use the same user, password and database above. URL-encode special characters.
DATABASE_URL=postgresql://project_user:CHANGE_TO_RANDOM_ALPHANUMERIC_PASSWORD@postgres:5432/project_manager?schema=public
MINIO_ROOT_USER=CHANGE_TO_RANDOM_USER
MINIO_ROOT_PASSWORD=CHANGE_TO_LONG_RANDOM_PASSWORD
MINIO_BUCKET=task-attachments
LOGIN_RATE_LIMIT_SECRET=CHANGE_TO_LONG_RANDOM_SECRET
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_TO_LONG_RANDOM_PASSWORD
