generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================================
// ENUMS
// ==================================

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
  CONTROLLER
}

enum ProjectStatus {
  DRAFT
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  MANAGER
  MEMBER
  CONTROLLER
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum ProgressTarget {
  PROJECT
  SPRINT
}

enum LoginAttemptScope {
  ACCOUNT
  IP
}

// ==================================
// USERS
// ==================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  nationalId   String?  @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects    Project[]         @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  sessions           Session[]
  assignedTasks      Task[]            @relation("TaskAssignee")
  createdTasks       Task[]            @relation("TaskCreator")
  comments           TaskComment[]
  progressUpdates    ProgressHistory[]
  deletedTasks       Task[]            @relation("TaskDeletedBy")

  @@index([role])
}

// ==================================
// PROJECTS
// ==================================

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(DRAFT)
  priority    Priority      @default(MEDIUM)

  startDate DateTime?
  dueDate   DateTime?
  progress  Int       @default(0)

  createdById String
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  members         ProjectMember[]
  sprints         Sprint[]
  tasks           Task[]
  progressHistory ProgressHistory[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([status])
  @@index([dueDate])
  @@index([archivedAt])
}

// ==================================
// PROJECT MEMBERS
// ==================================

model ProjectMember {
  id        String @id @default(uuid())
  projectId String
  userId    String

  role ProjectMemberRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// ==================================
// SPRINTS
// ==================================

model Sprint {
  id       String       @id @default(uuid())
  name     String
  goal     String?
  status   SprintStatus @default(PLANNED)
  progress Int          @default(0)

  startDate DateTime?
  endDate   DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks           Task[]
  progressHistory ProgressHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

// ==================================
// TASKS
// ==================================

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  status   TaskStatus @default(TODO)
  priority Priority   @default(MEDIUM)

  startDate DateTime?
  dueDate   DateTime?

  position Float @default(0)
  version  Int   @default(1)

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?    @relation("TaskDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  comments TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status, position])
  @@index([assigneeId, status])
  @@index([sprintId])
  @@index([dueDate])
  @@index([projectId, deletedAt, status, position])
  @@index([deletedAt])
}

// ==================================
// TASK COMMENTS
// ==================================

model TaskComment {
  id       String @id @default(uuid())
  content  String
  taskId   String
  authorId String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

// ==================================
// PROGRESS HISTORY
// ==================================

model ProgressHistory {
  id       String         @id @default(uuid())
  target   ProgressTarget
  progress Int
  note     String?

  projectId String?
  sprintId  String?

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint  Sprint?  @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  updatedById String
  updatedBy   User   @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([sprintId, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id          String            @id @default(uuid())
  scope       LoginAttemptScope
  keyHash     String
  attemptedAt DateTime          @default(now())

  @@index([scope, keyHash, attemptedAt])
  @@index([attemptedAt])
}
